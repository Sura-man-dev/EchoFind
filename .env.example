DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
IMAGEKIT_PRIVATE_KEY="replace-with-your-imagekit-private-key"
IMAGEKIT_PUBLIC_KEY="replace-with-your-imagekit-public-key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your-imagekit-id"
GEMINI_API_KEY=""
# Optional: pin an enabled Gemini generateContent model. Otherwise EchoFind
# discovers available models and tries compatible Flash models automatically.
# GEMINI_MODEL="gemini-2.5-flash"

# Set on self-hosted production behind a trusted proxy. Vercel sets this automatically.
AUTH_TRUST_HOST="true"

# Optional OAuth providers
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_FACEBOOK_ID=""
# AUTH_FACEBOOK_SECRET=""

# Optional SMTP settings for password-reset email
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
